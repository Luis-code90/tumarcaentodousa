VITE_WHATSAPP_NUMBER=14079906841

# Supabase project for TuMarcaEnTodo (separate project/account from Catálogo Mirlo).
# Find these under Project Settings > API in the Supabase dashboard.
# VITE_SUPABASE_ANON_KEY is safe to expose client-side — RLS policies in
# supabase/rls.sql are what actually restrict access, not this key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudinary — used by the admin panel (/admin) to upload product/package
# photos straight from the browser via an UNSIGNED upload preset. The cloud
# name and preset name are safe to expose client-side (same reasoning as
# the Supabase anon key above) — they don't grant access to your account,
# only to that one preset's upload endpoint.
#
# Create the preset at Cloudinary Dashboard > Settings > Upload >
# Upload presets > Add upload preset, with:
#   - Signing mode: Unsigned
#   - Folder: tumarcaentodo (or whatever you prefer — keeps uploads scoped)
#   - Allowed formats: jpg, png, webp
#   - Max file size: 5000000 (5MB, matches the client-side check in
#     src/lib/cloudinary.js)
# These preset-level restrictions are the real enforcement — the client-side
# checks are just a fast, friendly error message before that.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset-name
